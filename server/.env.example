# This app runs fully free by default — no signup, no API key, no cost.
# Copy this file to ".env" to customize translation or enable persistent
# user accounts.

# Defaults to trying https://lingva.ml then https://translate.plausibility.cloud
# LINGVA_URL=https://lingva.ml

# Free Neon Postgres connection string (console.neon.tech). Without this,
# accounts are stored in a local JSON file that resets on server restart.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stable session secret. Without this, a random one is generated each
# startup and everyone gets logged out whenever the server restarts.
# SESSION_SECRET=

# Comma-separated emails allowed to use "Add recipe" (everyone else,
# including anonymous visitors, won't see it — enforced server-side too).
# ADMIN_EMAILS=you@example.com,teammate@example.com
